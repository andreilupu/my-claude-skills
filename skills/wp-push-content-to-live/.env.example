# Copy to .env and fill in. .env is git-ignored — never commit it.
# Create an Application Password in WP Admin → Users → Profile → Application Passwords.

WP_SITE_URL=https://example.com
WP_USERNAME=your-user-slug
# Application Password contains spaces — KEEP THE QUOTES (or remove the spaces).
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
